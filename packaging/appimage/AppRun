#!/bin/sh
SELF="$(readlink -f "$0")"
HERE="${SELF%/*}"

export GTK_USE_PORTAL=1

# Resolve base EAGLE_SHARE directory dynamically across AppImage, Flatpak, and system layouts
if [ -d "${HERE}/usr/share/eagle" ]; then
    EAGLE_SHARE="${HERE}/usr/share/eagle"
elif [ -d "${HERE}/../share/eagle" ]; then
    EAGLE_SHARE="${HERE}/../share/eagle"
elif [ -d "/app/share/eagle" ]; then
    EAGLE_SHARE="/app/share/eagle"
else
    EAGLE_SHARE="/usr/share/eagle"
fi

export NODE_PATH="${EAGLE_SHARE}/app/node_modules:${NODE_PATH:-}"

# Eagle's video and exif plugins shell out to ffmpeg, ffprobe and exiv2. The
# AppImage carries its own copies, so put them ahead of the host's: an AppImage
# is expected to be self-contained, and the plugins fail silently when these
# are missing. The binaries carry an RPATH into usr/lib/eagle-tools, so nothing
# is added to LD_LIBRARY_PATH and Electron is unaffected.
if [ -d "${HERE}/usr/bin" ]; then
    export PATH="${HERE}/usr/bin:${PATH}"
fi

PATCH="${EAGLE_SHARE}/patch.js"
APP="${EAGLE_SHARE}/app"

# Locate Electron binary
# Prefer an Electron bundled with this package (AppImage payload first, then
# the Flatpak location). Bootstrapping via npx is unreliable on current
# distros -- npm >= 12 blocks install scripts and Node >= 26 breaks Electron's
# extract-zip -- so it is only a fallback now.
if [ -x "${EAGLE_SHARE}/electron/electron" ]; then
    ELECTRON_BIN="${EAGLE_SHARE}/electron/electron"
elif [ -f "/app/electron/electron" ]; then
    ELECTRON_BIN="/app/electron/electron"
elif command -v electron22 >/dev/null 2>&1; then
    ELECTRON_BIN="$(command -v electron22)"
elif command -v electron >/dev/null 2>&1; then
    ELECTRON_BIN="$(command -v electron)"
elif command -v npx >/dev/null 2>&1; then
    # Prime the npx cache before healing it. npm >= 12 blocks postinstall
    # scripts via its allowScripts policy and --ignore-scripts=false no longer
    # overrides that, so this first call may leave electron unpacked but
    # without its binary. The heal loop below then runs install.js directly.
    # Without priming, a cold cache has nothing to heal and the launch fails.
    npx --yes --ignore-scripts=false electron@22.3.7 --version >/dev/null 2>&1 || true
    for cache_dir in "${HOME}/.npm/_npx/"*/node_modules/electron; do
        if [ -d "${cache_dir}" ] && [ ! -f "${cache_dir}/path.txt" ]; then
            if [ -f "${cache_dir}/install.js" ]; then
                (cd "${cache_dir}" && node install.js 2>/dev/null || true)
            fi
            if [ ! -f "${cache_dir}/path.txt" ]; then
                rm -rf "${cache_dir%/*/*}" 2>/dev/null || true
            fi
        fi
    done
    ELECTRON_BIN="npx --yes --ignore-scripts=false electron@22.3.7"
else
    echo "[ERROR] No Electron runtime found. Please install electron or nodejs."
    exit 1
fi

echo "[INFO] Launching Eagle with ${ELECTRON_BIN}..."
echo "[INFO] App directory: ${APP}"

if [ -x "/app/bin/zypak-wrapper" ]; then
    exec /app/bin/zypak-wrapper "${ELECTRON_BIN}" -r "${PATCH}" "${APP}" --no-sandbox "$@"
else
    exec ${ELECTRON_BIN} -r "${PATCH}" "${APP}" --no-sandbox "$@"
fi
